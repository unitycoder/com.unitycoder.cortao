#pragma kernel TraceMediumR32Ortho CORTAO_SAMPLE_COUNT=16 CORTAO_RAY_COUNT=32 CORTAO_WRITE_BENT=0 CORTAO_ORTHOGRAPHIC_PROJECTION=1
#pragma kernel TraceMediumBentR32 CORTAO_SAMPLE_COUNT=16 CORTAO_RAY_COUNT=32 CORTAO_WRITE_BENT=1 CORTAO_PERSPECTIVE_PROJECTION=1
#pragma kernel TraceMediumBentR32Ortho CORTAO_SAMPLE_COUNT=16 CORTAO_RAY_COUNT=32 CORTAO_WRITE_BENT=1 CORTAO_ORTHOGRAPHIC_PROJECTION=1
#pragma kernel TraceHighR32 CORTAO_SAMPLE_COUNT=32 CORTAO_RAY_COUNT=32 CORTAO_WRITE_BENT=0 CORTAO_PERSPECTIVE_PROJECTION=1
#pragma kernel TraceHighR32Ortho CORTAO_SAMPLE_COUNT=32 CORTAO_RAY_COUNT=32 CORTAO_WRITE_BENT=0 CORTAO_ORTHOGRAPHIC_PROJECTION=1
#pragma kernel TraceHighBentR32 CORTAO_SAMPLE_COUNT=32 CORTAO_RAY_COUNT=32 CORTAO_WRITE_BENT=1 CORTAO_PERSPECTIVE_PROJECTION=1
#pragma kernel TraceHighBentR32Ortho CORTAO_SAMPLE_COUNT=32 CORTAO_RAY_COUNT=32 CORTAO_WRITE_BENT=1 CORTAO_ORTHOGRAPHIC_PROJECTION=1
#pragma multi_compile _ _GBUFFER_NORMALS_OCT
#define CORTAO_HLSL 1
#define CORTAO_OCCLUDER_LOOKUP_TABLE 1
#include "../../Shaders/Reference/CORTAOMainPass.h"
#include "UnityNormals.hlsl"
Texture2D<uint> _Mip0;
Texture2D<uint> _Mip1;
Texture2D<uint> _Mip2;
Texture2D<uint> _Mip3;
Texture2D<uint> _Mip4;
Texture2D<uint> _Mip5;
Texture2D<uint> _Mip6;
Texture2D<uint> _Mip7;
StructuredBuffer<uint> _Lookup;
RWTexture2D<float> _RawAO;
#if CORTAO_WRITE_BENT
RWTexture2D<float4> _Bent;
#endif
int _PackedResolution, _Seed, _MipCount;
#include "Resolution.hlsl"
float4 _LutSize;
float4 _Unproject, _Project, _TraceParams, _TraceParams2;
float4 _DistanceFade; // start, end, inverse range, enabled
int _MipmappedPyramid;
uint cortao_samplePackedData(float2 uv, float mip)
{
    if(any(uv < 0) || any(uv >= 1)) return 0;
    int level = clamp((int)floor(mip + 0.5),0,_MipCount-1);
    uint2 size = max(uint2(_PackedResolution & 65535, (uint)_PackedResolution >> 16) >> level,1u);
    int2 p = min((int2)(uv*size),(int2)size-1);
    if(_MipmappedPyramid != 0) return _Mip0.Load(int3(p,level));
    switch(level) {
        case 0: return _Mip0.Load(int3(p,0));
        case 1: return _Mip1.Load(int3(p,0));
        case 2: return _Mip2.Load(int3(p,0));
        case 3: return _Mip3.Load(int3(p,0));
        case 4: return _Mip4.Load(int3(p,0));
        case 5: return _Mip5.Load(int3(p,0));
        case 6: return _Mip6.Load(int3(p,0));
        case 7: return _Mip7.Load(int3(p,0));
    }
    return 0;
}
float3 cortao_loadNormal(int2 p) { return ReadNormal(FullPixel(p)); }
uint cortao_sampleOccluderLookupTable(float3 uv)
{
    int3 size = (int3)_LutSize.xyz;
    int3 p = clamp((int3)floor(uv * size),0,size-1);
    return _Lookup[p.x + size.x*(p.y + size.y*p.z)];
}
void cortao_writeResult(int2 p,float ao,float3 bent,float3x3 basis,uint bits)
{
    float visibility = ((asuint(ao) & 0x7f800000u) != 0x7f800000u) ? saturate(ao) : 1.0;
    float fade = 1.0;
    if (_DistanceFade.w > 0.5)
    {
        float depth = cortao_unpackDepth(_Mip0.Load(int3(p,0)));
        fade = saturate((_DistanceFade.y-depth)*_DistanceFade.z);
        fade = fade*fade*(3.0-2.0*fade);
    }
    _RawAO[p] = lerp(1.0,visibility,fade);
#if CORTAO_WRITE_BENT
    float3 n=all((asuint(bent) & 0x7f800000u) != 0x7f800000u) && dot(bent,bent)>1e-6 ? normalize(bent):cortao_loadNormal(p);
    if (fade < 1.0)
    {
        float3 surface = cortao_loadNormal(p);
        float3 mixed = lerp(surface,n,fade);
        n = dot(mixed,mixed)>1e-6 ? normalize(mixed) : surface;
    }
    _Bent[p]=float4(n*0.5+0.5,1);
#endif
}
void Run(uint2 p)
{
    uint2 size = uint2(_PackedResolution & 65535,(uint)_PackedResolution >> 16);
    if(any(p >= size)) return;
    uint center = _Mip0.Load(int3(p,0));
    if(center == 0) { _RawAO[p] = 1;
#if CORTAO_WRITE_BENT
    _Bent[p]=float4(0.5,0.5,1,1);
#endif
    return; }
    if (_DistanceFade.w > 0.5 && cortao_unpackDepth(center) >= _DistanceFade.y)
    {
        _RawAO[p] = 1.0;
#if CORTAO_WRITE_BENT
        _Bent[p] = float4(cortao_loadNormal(p)*0.5+0.5,1.0);
#endif
        return;
    }
    CORTAOMainPassParameters a = (CORTAOMainPassParameters)0;
    a.packedResolution = _PackedResolution; a.randomSeed = _Seed;
    a.unprojectParams = _Unproject; a.projectionParams = _Project;
    a.normalBias = _TraceParams.x; a.radius = _TraceParams.y;
    a.maxApparentCircleRadiusCoefficient = _TraceParams.z; a.mipBias = _TraceParams.w;
    a.inverseMaxSlopeCompensation = _TraceParams2.x; a.backfaceThreshold = _TraceParams2.y;
    a.backfaceBoost = _TraceParams2.z;
    cortao_mainPass(p,a);
}

